# Included inside the existing app server block on the production host.
# Temporary Beget connectivity workaround (2026-09-13); verify TLS after reload.
ssl_protocols TLSv1.2;

root "__APPLICATION_ROOT__/public";
index index.php;
charset utf-8;
server_tokens off;
client_max_body_size 200m;

location / {
    try_files $uri $uri/ /index.php?$query_string;
}

# Laravel's public/storage symlink points inside the PHP container.
location /storage/ {
    alias "__APPLICATION_ROOT__/storage/app/public/";
}

location = /index.php {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
    fastcgi_param DOCUMENT_ROOT /var/www/html/public;
    fastcgi_param HTTPS $https if_not_empty;
    fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;
    fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
    fastcgi_param HTTP_X_REAL_IP $remote_addr;
    fastcgi_param HTTP_PROXY "";
    fastcgi_pass 127.0.0.1:9000;
    fastcgi_read_timeout 300s;
    fastcgi_hide_header X-Powered-By;
}

location ~* \.php(?:/|$) {
    return 404;
}

location ~ /\.(?!well-known/) {
    deny all;
}
